    <script>
        // fallback: si por alguna razon jquery.validate no está registrado, cargarlo dinámicamente
        (function(){
            if (typeof jQuery === 'undefined') return;
            if (typeof jQuery.fn.validate === 'undefined') {
                var s = document.createElement('script');
                s.src = '/Scripts/jquery.validate.min.js';
                s.async = false;
                document.head.appendChild(s);
            }
        })();
    </script>
    <script src="~/Template/js/plugins.js"></script>
    <script src="~/Template/js/script.js"></script>
    @RenderSection("Scripts", required: false)
    <script>
        // Modal control: seguir comprando y validar proceder al pago
        (function(){
            var seguir = document.getElementById('modal-seguir-comprando');
            if (seguir) seguir.addEventListener('click', function(){
                if (typeof $ !== 'undefined' && $.fn.modal) $('#modalCarrito').modal('hide');
                else {
                    var m = document.getElementById('modalCarrito'); if (m) { m.style.display='none'; m.classList.remove('show'); }
                }
            });

            var proceder = document.getElementById('modal-proceder-pago');
            if (proceder) proceder.addEventListener('click', function(e){
                e.preventDefault();
                fetch('@Url.Action("VerificarSesion","Account")')
                    .then(function(res){ return res.json(); })
                    .then(function(data){
                        if (data && data.autenticado) {
                            window.location.href = '@Url.Action("Checkout","Carrito")';
                        } else {
                            if (typeof $ !== 'undefined' && $.fn.modal) $('#modalCarrito').modal('hide');
                            window.location.href = '@Url.Action("Login","Account")?returnUrl=' + encodeURIComponent('@Url.Action("Checkout","Carrito")');
                        }
                    }).catch(function(){ window.location.href = '@Url.Action("Login","Account")'; });
            });
        })();
    </script>
