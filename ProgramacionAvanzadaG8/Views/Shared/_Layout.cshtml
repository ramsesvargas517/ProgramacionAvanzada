@using ProgramacionAvanzadaG8.Models
@{
    var carritoSesion = Session["Carrito"] as List<CarritoItemModel> ?? new List<CarritoItemModel>();
    decimal carritoSubtotal = carritoSesion.Sum(x => x.Subtotal);
    int carritoCount = carritoSesion.Sum(x => x.Cantidad);
}
