    <div class="preloader" style="position:fixed;top:0;left:0;width:100%;height:100%;background-color:#fff;display:flex;align-items:center;justify-content:center;z-index:9999;">
        <svg version="1.1" id="L4" width="100" height="100" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 50 100" enable-background="new 0 0 0 0" xml:space="preserve">
        <circle fill="#111" stroke="none" cx="6" cy="50" r="6"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.1" /></circle>
        <circle fill="#111" stroke="none" cx="26" cy="50" r="6"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.2" /></circle>
        <circle fill="#111" stroke="none" cx="46" cy="50" r="6"><animate attributeName="opacity" dur="1s" values="0;1;0" repeatCount="indefinite" begin="0.3" /></circle>
        </svg>
    </div>

    <div class="search-box bg-dark position-relative">
        <div class="search-wrap">
            <div class="close-button">
                <svg class="close" style="fill:white;"><use xlink:href="#close"></use></svg>
            </div>
            @using (Html.BeginForm("Index", "Home", FormMethod.Get, new { id = "search-form", @class = "text-lg-center text-md-left pt-3" }))
            {
                <input type="text" name="q" class="search-input" placeholder="Buscar juguetes..." />
                <svg class="search"><use xlink:href="#search"></use></svg>
            }
        </div>
    </div>

    @*abre el modal del carrito*@
    <div class="modal fade" id="modalCarrito" tabindex="-1" aria-modal="true" role="dialog">
        <div class="modal-dialog modal-fullscreen-md-down modal-md modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h2 class="modal-title fs-5 fw-bold">
                        &#128722; Carrito
                        @if (carritoCount > 0)
                        {
                            <span class="badge bg-danger ms-2" style="font-size:12px;">@carritoCount</span>
                        }
                    </h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    @if (!carritoSesion.Any())
                    {
                        <div class="mini-empty">
                            <div class="mini-empty-icon">&#128722;</div>
                            <p class="mb-3">Tu carrito est&#225; vac&#237;o</p>
                            <a href="@Url.Action("Tienda","Home")" class="btn btn-sm btn-dark rounded-pill px-4"
                               data-bs-dismiss="modal">Ver Tienda</a>
                        </div>
                    }
                    else
                    {
                        <div class="mini-cart-list">
                            @foreach (var item in carritoSesion)
                            {
                                <div class="mini-item-row">
                                    <div class="mini-item-thumb">
                                        @if (!string.IsNullOrEmpty(item.Imagen))
                                        {
                                            <img src="@item.Imagen" alt="@item.Nombre" class="mini-item-img" />
                                        }
                                        else
                                        {
                                            <span style="font-size:24px;">&#128247;</span>
                                        }
                                    </div>
                                    <div class="mini-item-info">
                                        <p class="mini-item-nombre">@item.Nombre</p>
                                        <span class="mini-item-detalle">@item.Cantidad x &#8353;@item.Precio.ToString("N0")</span>
                                    </div>
                                    <span class="mini-item-precio">&#8353;@item.Subtotal.ToString("N0")</span>
                                    @using (Html.BeginForm("Eliminar", "Carrito", FormMethod.Post, new { style = "display:inline;" }))
                                    {
                                        @Html.Hidden("productoId", item.ProductoId)
                                        <button type="submit" class="mini-item-remove" title="Eliminar">&times;</button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="mini-subtotal-row border-top mt-2">
                            <span class="fw-bold">Subtotal</span>
                            <span class="fw-bold" style="color:#e74c3c;font-size:1.1rem;">&#8353;@carritoSubtotal.ToString("N0")</span>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <a href="@Url.Action("Index","Carrito")" class="btn btn-dark rounded-3 fw-bold">Ver carrito completo</a>
                            <a href="#" id="modal-proceder-pago" class="btn btn-outline-dark rounded-3 fw-bold">Proceder al pago</a>
                            <button type="button" id="modal-seguir-comprando" class="btn btn-secondary rounded-3">Seguir comprando</button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <header id="header" class="site-header text-black">
        <div class="frijolito-topbar">
            <div class="container-lg frijolito-topbar-inner">
                <div class="frijolito-topbar-left">
                    <a href="mailto:frijolitojugueteria@gmail.com">frijolitojugueteria&#64;gmail.com</a>
                    <span>/</span>
                    <span>+506 1234-5678</span>
                </div>
                <div class="frijolito-topbar-right">
                    <a href="#" aria-label="Facebook"><svg width="18" height="18"><use xlink:href="#facebook"></use></svg></a>
                    <a href="#" aria-label="Instagram"><svg width="18" height="18"><use xlink:href="#instagram"></use></svg></a>
                    <a href="#" aria-label="YouTube"><svg width="18" height="18"><use xlink:href="#youtube"></use></svg></a>
                    <a href="#" aria-label="Pinterest"><svg width="18" height="18"><use xlink:href="#pinterest"></use></svg></a>
                </div>
            </div>
        </div>

        <nav id="header-nav" class="navbar navbar-expand-lg frijolito-navbar">
            <div class="container-lg">
                <a class="navbar-brand" href="@Url.Action("Index", "Home")">
                    <img src="~/Template/Images/main-logo.png" class="logo frijolito-logo" alt="Frijolito Jugueter&#237;a" />
                </a>

                <button class="navbar-toggler d-flex d-lg-none order-3 border-0 p-1 ms-2" type="button"
                        data-bs-toggle="offcanvas" data-bs-target="#bdNavbar"
                        aria-controls="bdNavbar" aria-expanded="false" aria-label="Men&#250;">
                    <svg class="navbar-icon"><use xlink:href="#navbar-icon"></use></svg>
                </button>

                <div class="offcanvas offcanvas-end" tabindex="-1" id="bdNavbar">
                    <div class="offcanvas-header px-4 pb-0">
                        <a class="navbar-brand ps-3" href="@Url.Action("Index", "Home")">
                            <img src="~/Template/Images/main-logo.png" class="logo frijolito-logo" alt="Frijolito" />
                        </a>
                        <button type="button" class="btn-close btn-close-black p-5"
                                data-bs-dismiss="offcanvas" aria-label="Cerrar" data-bs-target="#bdNavbar"></button>
                    </div>
                    <div class="offcanvas-body">
                        <ul id="navbar" class="navbar-nav fw-bold justify-content-center align-items-center flex-grow-1 frijolito-menu">
                            <li class="nav-item">
                                <a class="nav-link active" href="@Url.Action("Index","Home")">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Ninos","Home")">Ni&#241;os</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Ninas","Home")">Ni&#241;as</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle border-0" href="#"
                                   data-bs-toggle="dropdown" aria-expanded="false">Categor&#237;as</a>
                                <ul class="dropdown-menu fw-bold">
                                    @if (ViewBag.Categorias != null)
                                    {
                                        foreach (var cat in ViewBag.Categorias as List<ProgramacionAvanzadaG8.Models.CategoriaModel>)
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                   href="@Url.Action("Tienda","Home", new { categoriaId = cat.CategoriaId })">
                                                    @cat.Nombre
                                                </a>
                                            </li>
                                        }
                                    }
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Tienda","Home")">Tienda</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="@Url.Action("Tienda","Home")">Ofertas</a>
                            </li>
                        </ul>
                    </div>
                </div>

                <div class="user-items ps-0 ps-md-4">
                    <ul class="d-flex justify-content-end list-unstyled align-items-center m-0 frijolito-user-icons">
                        @if (Session["UsuarioId"] != null)
                        {
                            <li class="me-2">
                                <span class="d-inline-block">@Session["UsuarioNombre"]</span>
                            </li>
                            <li>
                                <a href="@Url.Action("Logout","Account")" class="border-0 btn btn-sm btn-outline-secondary" title="Cerrar sesión">Cerrar sesión</a>
                            </li>
                        }
                        else
                        {
                            <li>
                                <a href="@Url.Action("Login", "Account")" class="border-0" title="Mi Cuenta">
                                    <svg class="user" width="24" height="24"><use xlink:href="#user"></use></svg>
                                </a>
                            </li>
                        }
                        <li>

                            <a href="#" class="border-0 carrito-nav-wrap" title="Carrito"
                               data-bs-toggle="modal" data-bs-target="#modalCarrito">
                                <svg class="shopping-cart" width="24" height="24"><use xlink:href="#shopping-cart"></use></svg>
                                @if (carritoCount > 0)
                                {
                                    <span class="carrito-badge">@carritoCount</span>
                                }
                            </a>
                        </li>
                        <li>
                            <a href="#" class="search-item border-0" title="Buscar">
                                <svg class="search" width="24" height="24"><use xlink:href="#search"></use></svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @RenderBody()

