@model Frijolito.Models.UsuarioModel
@{
    ViewBag.Title = "Recuperar Contraseña";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card border-0 shadow-sm p-4">

                    <div class="text-center mb-4">
                        <h2 class="fs-3 fw-normal">Recuperar Contraseña</h2>
                        <p class="text-muted">
                            Ingrese su correo electrónico y le enviaremos las instrucciones para restablecer su contraseña.
                        </p>
                    </div>

                    @* Mensaje informativo del controller *@
                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-info" role="alert">
                            @ViewBag.Mensaje
                        </div>
                    }

                    @using (Html.BeginForm("RecuperarContrasenna", "Account", FormMethod.Post))
                    {
                        @Html.AntiForgeryToken()

                        <div class="login-form">
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.Email, new
                                {
                                    @class      = "ps-3 text-input w-100",
                                    placeholder = "Correo Electrónico *",
                                    required    = "required",
                                    type        = "email"
                                })
                                @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                            </div>

                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <button type="submit" class="btn btn-red hvr-sweep-to-right dark-sweep">
                                    Enviar Instrucciones
                                </button>
                                <a href="@Url.Action("Login", "Account")"
                                   class="btn btn-outline-gray hvr-sweep-to-right dark-sweep">
                                    Volver al Login
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
