@using ProgramacionAvanzadaG8.Models
@{
    ViewBag.Title = "Inicio";
    var productos = ViewBag.Productos as List<ProductoModel> ?? new List<ProductoModel>();
}
<meta charset="utf-8" />

<!-- MODAL -->
<div class="modal fade" id="modaltoggle" aria-hidden="true" tabindex="-1">
    <div class="modal-dialog modal-fullscreen-md-down modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body">

                <!-- IMAGEN -->
                <div class="col-lg-12 col-md-12 me-3">
                    <img id="modalImg" src="" alt="Producto"
                         style="width:100%; max-height:400px; object-fit:contain;" />
                </div>

                <!-- INFO -->
                <div class="col-lg-12 col-md-12">
                    <div class="summary">
                        <div class="summary-content fs-6">

                            <div class="product-header d-flex justify-content-between mt-4">
                                <h3 id="modalNombre"></h3>
                                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                            </div>

                            <span class="product-price fs-3" id="modalPrecio"></span>

                            <p id="modalDesc"></p>

                            <ul>
                                <li><strong>SKU:</strong> <span id="modalSku"></span></li>
                                <li><strong>Categoría:</strong> <span id="modalCat"></span></li>
                            </ul>

                            <!-- CANTIDAD + FORM -->
                            <div class="row mt-3">

                                <!-- CANTIDAD VISUAL -->
                                <div class="col-md-6">
                                    <input type="number" id="cantidadVisual"
                                           class="form-control text-center"
                                           min="1" value="1" />
                                </div>

                                <!-- FORM REAL -->
                                <div class="col-md-6">
                                    @using (Html.BeginForm("Agregar", "Carrito", FormMethod.Post))
                                    {
                                        <input type="hidden" id="modalProductoId" name="productoId" />
                                        <input type="hidden" id="modalCantidadHidden" name="cantidad" value="1" />

                                        <button type="submit" class="btn btn-dark w-100">
                                            Agregar al carrito
                                        </button>
                                    }
                                </div>

                            </div>

                        </div>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>


<!-- PRODUCTOS -->
@if (productos.Any())
{
    <section class="py-5">
        <div class="container-lg">
            <h2 class="mb-4">Productos</h2>

            <div class="row g-4">
                @foreach (var p in productos)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <div class="card border-0 h-100 product-card"
                             style="cursor:pointer;"
                             data-id="@p.ProductoId"
                             data-nombre="@p.Nombre"
                             data-precio="@p.Precio.ToString("N0")"
                             data-desc="@(p.Descripcion ?? "")"
                             data-sku="@p.Sku"
                             data-cat="@p.CategoriaNombre"
                             data-img="@(string.IsNullOrEmpty(p.Imagen) ? "" : p.Imagen)"
                             data-bs-toggle="modal"
                             data-bs-target="#modaltoggle">

                            <!-- IMAGEN -->
                            <div style="height:220px;background:#f8f8f8;overflow:hidden;border-radius:8px;">
                                @if (!string.IsNullOrEmpty(p.Imagen))
                                {
                                    <img src="@p.Imagen" alt="@p.Nombre"
                                         style="width:100%;height:100%;object-fit:contain;padding:10px;" />
                                }
                                else
                                {
                                    <div style="display:flex;align-items:center;justify-content:center;height:100%;">
                                        📷
                                    </div>
                                }
                            </div>

                            <!-- INFO -->
                            <div class="card-body px-0 pb-0">
                                <small class="text-muted">@p.CategoriaNombre</small>
                                <h6>@p.Nombre</h6>
                                <strong>₡@p.Precio.ToString("N0")</strong>
                            </div>

                        </div>
                    </div>
                }
            </div>
        </div>
    </section>
}


@section Scripts {
    <script>
        // CLICK EN PRODUCTO
        document.querySelectorAll('.product-card').forEach(function (card) {

            card.addEventListener('click', function () {

                // IMAGEN
                var img = this.dataset.img;
                var el = document.getElementById('modalImg');
                el.src = img || '';
                el.style.display = img ? 'block' : 'none';

                // TEXTO
                document.getElementById('modalNombre').textContent = this.dataset.nombre;
                document.getElementById('modalPrecio').textContent = '₡' + this.dataset.precio;
                document.getElementById('modalDesc').textContent = this.dataset.desc;
                document.getElementById('modalSku').textContent = this.dataset.sku;
                document.getElementById('modalCat').textContent = this.dataset.cat;

                // 🔥 PRODUCTO ID
                document.getElementById('modalProductoId').value = this.dataset.id;

                // RESET CANTIDAD
                document.getElementById('cantidadVisual').value = 1;
                document.getElementById('modalCantidadHidden').value = 1;
            });

        });


        // SINCRONIZAR CANTIDAD
        document.getElementById('cantidadVisual').addEventListener('input', function () {
            document.getElementById('modalCantidadHidden').value = this.value;
        });
    </script>
}