@model Frijolito.Models.UsuarioModel
@{
    ViewBag.Title = "Iniciar Sesión";
}

<section class="py-5 mt-4">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="card border-0 shadow-sm p-4">

                    <div class="text-center mb-4">
                        <h2 class="fs-3 fw-normal">Iniciar Sesión</h2>
                        <p class="text-muted">Bienvenido de vuelta a Frijolito</p>
                    </div>

                    @* Mensaje de error proveniente del controller *@
                    @if (ViewBag.Mensaje != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.Mensaje
                        </div>
                    }

                    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { id = "login-form" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="login-form">
                            <div class="mb-3">
                                @Html.TextBoxFor(m => m.Username, new
                                {
                                    @class       = "ps-3 text-input w-100",
                                    placeholder  = "Nombre de Usuario *",
                                    autocomplete = "username"
                                })
                                @Html.ValidationMessageFor(m => m.Username, "", new { @class = "text-danger small" })
                            </div>

                            <div class="mb-3">
                                @Html.PasswordFor(m => m.PasswordHash, new
                                {
                                    @class       = "ps-3 text-input w-100",
                                    placeholder  = "Contraseña *",
                                    autocomplete = "current-password"
                                })
                                @Html.ValidationMessageFor(m => m.PasswordHash, "", new { @class = "text-danger small" })
                            </div>

                            <div class="checkbox d-flex justify-content-between mt-4">
                                <p class="checkbox-form">
                                    <label>
                                        <input type="checkbox" name="rememberme" value="true"> Recordarme
                                    </label>
                                </p>
                                <p class="lost-password">
                                    <a href="@Url.Action("RecuperarContrasenna", "Account")">¿Olvidó su contraseña?</a>
                                </p>
                            </div>

                            <div class="d-flex justify-content-center gap-3 mt-4">
                                <button type="submit" class="btn btn-red hvr-sweep-to-right dark-sweep">
                                    Iniciar Sesión
                                </button>
                                <a href="@Url.Action("Registro", "Account")"
                                   class="btn btn-outline-gray hvr-sweep-to-right dark-sweep">
                                    Registrarse
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
