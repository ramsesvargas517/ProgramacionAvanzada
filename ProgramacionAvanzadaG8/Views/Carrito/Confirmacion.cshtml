@{
    ViewBag.Title = "Compra Confirmada";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5" style="min-height:70vh;background:#f9f9f9;display:flex;align-items:center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-8 col-lg-6">
                <div class="bg-white rounded-4 shadow-sm p-5 text-center">

                    <div style="width:80px;height:80px;background:#d4edda;border-radius:50%;
                                display:flex;align-items:center;justify-content:center;
                                margin:0 auto 24px;font-size:40px;">
                        &#9989;
                    </div>

                    <h2 style="font-weight:800;color:#111;margin-bottom:8px;">
                        &#161;Compra realizada con &#233;xito!
                    </h2>
                    <p class="text-muted mb-4">
                        Gracias por tu compra. Tu pedido ha sido procesado correctamente.
                    </p>

                    <div style="background:#f8f9fa;border-radius:12px;padding:20px;margin-bottom:28px;">
                        <p class="text-muted mb-1" style="font-size:13px;">N&#250;mero de venta</p>
                        <h3 style="font-weight:900;color:#e74c3c;font-size:2rem;margin:0;">
                            #@ViewBag.VentaId
                        </h3>
                    </div>

                    <p class="text-muted mb-4" style="font-size:14px;">
                        Guarda este n&#250;mero como referencia de tu compra.<br />
                        Nos pondremos en contacto contigo pronto.
                    </p>

                    <div class="d-flex gap-3 justify-content-center flex-wrap">
                        <a href="@Url.Action("Tienda","Home")"
                           class="btn btn-dark rounded-pill px-5 fw-bold">
                            &#128722; Seguir comprando
                        </a>
                        <a href="@Url.Action("Index","Home")"
                           class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                            Ir al inicio
                        </a>
                    </div>

                </div>
            </div>
        </div>
    </div>
</section>
