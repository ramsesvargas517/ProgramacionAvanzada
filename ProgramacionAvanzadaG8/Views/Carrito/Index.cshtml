@model List<ProgramacionAvanzadaG8.Models.CarritoItemModel>
@{
    ViewBag.Title = "Carrito";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = Model != null ? Model.Sum(x => x.Subtotal) : 0;
}

<section class="py-5" style="min-height:60vh;background:#f9f9f9;">
    <div class="container">

        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <span>&#9989;</span> <span>@TempData["Success"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show d-flex align-items-center gap-2" role="alert">
                <span>&#10060;</span> <span>@TempData["Error"]</span>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert"></button>
            </div>
        }

        <div class="d-flex align-items-center gap-3 mb-4">
            <h1 style="font-size:2rem;font-weight:800;margin:0;">Carrito de Compras</h1>
            @if (Model != null && Model.Any())
            {
                <span class="badge bg-dark rounded-pill" style="font-size:13px;">
                    @Model.Sum(x => x.Cantidad) producto(s)
                </span>
            }
        </div>

        @if (Model == null || !Model.Any())
        {
            <div class="text-center py-5 bg-white rounded-4 shadow-sm">
                <div style="font-size:72px;margin-bottom:16px;">&#128722;</div>
                <h3 style="font-weight:700;">Tu carrito est&#225; vac&#237;o</h3>
                <p class="text-muted">&#161;Agrega productos para empezar tu compra!</p>
                <a href="@Url.Action("Tienda","Home")"
                   class="btn btn-dark rounded-pill px-5 mt-2" style="font-weight:700;">
                    Ver Tienda
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="bg-white rounded-4 shadow-sm overflow-hidden">
                        @foreach (var item in Model)
                        {
                            <div class="carrito-row d-flex align-items-center gap-3 p-3 p-md-4"
                                 style="border-bottom:1px solid #f0f0f0;">

                                <div style="width:80px;height:80px;flex-shrink:0;background:#f5f5f5;
                                            border-radius:12px;overflow:hidden;display:flex;
                                            align-items:center;justify-content:center;">
                                    @if (!string.IsNullOrEmpty(item.Imagen))
                                    {
                                        <img src="@Url.Content(item.Imagen)" alt="@item.Nombre"
                                             style="width:100%;height:100%;object-fit:contain;padding:6px;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:32px;">&#128247;</span>
                                    }
                                </div>

                                <div style="flex:1;min-width:0;">
                                    <h6 style="font-weight:700;font-size:14px;margin:0 0 2px;
                                               white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">
                                        @item.Nombre
                                    </h6>
                                    <small class="text-muted">SKU: @item.SKU</small>
                                    <div style="font-weight:600;color:#e74c3c;margin-top:4px;font-size:15px;">
                                        &#8353;@item.Precio.ToString("N0")
                                    </div>
                                </div>

                                @using (Html.BeginForm("ActualizarCantidad", "Carrito", FormMethod.Post,
                                    new { @class = "d-flex align-items-center gap-2 flex-shrink-0" }))
                                {
                                    @Html.Hidden("productoId", item.ProductoId)
                                    <div style="display:flex;align-items:center;border:1px solid #ddd;
                                                border-radius:8px;overflow:hidden;">
                                        <button type="button" class="qty-btn-minus"
                                                style="width:30px;height:34px;background:#f5f5f5;border:none;
                                                       font-size:16px;cursor:pointer;">
                                            &#8722;
                                        </button>
                                        <input type="number" name="cantidad"
                                               value="@item.Cantidad" min="0" max="@item.StockDisponible"
                                               style="width:44px;height:34px;border:none;text-align:center;
                                                      font-weight:700;font-size:14px;outline:none;" />
                                        <button type="button" class="qty-btn-plus"
                                                data-max="@item.StockDisponible"
                                                style="width:30px;height:34px;background:#f5f5f5;border:none;
                                                       font-size:16px;cursor:pointer;">
                                            &#43;
                                        </button>
                                    </div>
                                    <button type="submit"
                                            style="background:#f39c12;color:#fff;border:none;border-radius:8px;
                                                   padding:6px 12px;font-size:12px;font-weight:700;cursor:pointer;">
                                        Actualizar
                                    </button>
                                }

                                <div style="min-width:90px;text-align:right;font-weight:800;font-size:16px;flex-shrink:0;">
                                    &#8353;@item.Subtotal.ToString("N0")
                                </div>

                                @using (Html.BeginForm("Eliminar", "Carrito", FormMethod.Post))
                                {
                                    @Html.Hidden("productoId", item.ProductoId)
                                    <button type="submit"
                                            style="width:34px;height:34px;border-radius:50%;background:#fee;
                                                   border:none;color:#e74c3c;font-size:18px;cursor:pointer;
                                                   flex-shrink:0;"
                                            onmouseover="this.style.background='#e74c3c';this.style.color='#fff';"
                                            onmouseout="this.style.background='#fee';this.style.color='#e74c3c';"
                                            title="Eliminar">
                                        &times;
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    <div class="mt-3">
                        <a href="@Url.Action("Tienda","Home")"
                           style="color:#555;text-decoration:none;font-weight:600;font-size:14px;">
                            &#8592; Seguir comprando
                        </a>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="bg-white rounded-4 shadow-sm p-4" style="position:sticky;top:100px;">
                        <h5 style="font-weight:800;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid #111;">
                            Resumen del pedido
                        </h5>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Subtotal</span>
                            <span>&#8353;@total.ToString("N0")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted">Env&#237;o</span>
                            <span class="text-success fw-bold">Gratis</span>
                        </div>
                        <div class="d-flex justify-content-between py-3">
                            <span style="font-weight:800;font-size:18px;">Total</span>
                            <span style="font-weight:800;font-size:18px;color:#e74c3c;">&#8353;@total.ToString("N0")</span>
                        </div>
                        <a href="@Url.Action("Checkout","Carrito")"
                           class="btn btn-dark w-100 rounded-3 fw-bold py-3" style="font-size:16px;">
                            Proceder al pago &#8594;
                        </a>
                        <p class="text-center text-muted mt-3 mb-0" style="font-size:12px;">
                            &#128274; Pago seguro y protegido
                        </p>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

@section Scripts {
    <script>document.querySelectorAll('.carrito-row').forEach(function(row) {
    var input = row.querySelector('input[name="cantidad"]');
    if (!input) return;
    row.querySelector('.qty-btn-minus').addEventListener('click', function() {
        var v = parseInt(input.value) || 1;
        if (v > 0) input.value = v - 1;
    });
    row.querySelector('.qty-btn-plus').addEventListener('click', function() {
        var v = parseInt(input.value) || 0;
        var max = parseInt(this.dataset.max) || 9999;
        if (v < max) input.value = v + 1;
    });
});</script>
}
