@model ProgramacionAvanzadaG8.Models.CheckoutViewModel
@{
    ViewBag.Title = "Finalizar Compra";
    Layout = "~/Views/Shared/_Layout.cshtml";
    decimal total = Model.ItemsCarrito != null ? Model.ItemsCarrito.Sum(x => x.Subtotal) : 0;
}

<section class="py-5" style="min-height:70vh;background:#f9f9f9;">
    <div class="container">

        <div class="mb-4">
            <h1 style="font-size:2rem;font-weight:800;margin:0 0 4px;">Finalizar Compra</h1>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-0" style="font-size:13px;">
                    <li class="breadcrumb-item"><a href="@Url.Action("Index","Home")">Inicio</a></li>
                    <li class="breadcrumb-item">
                        <a href="@Url.Action("Index","Carrito")">Carrito</a>
                    </li>
                    <li class="breadcrumb-item active">Pago</li>
                </ol>
            </nav>
        </div>

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                &#10060; @TempData["Error"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }

    <div class="row g-4">
        @* formulario *@
        <div class="col-lg-7">
            <div class="bg-white rounded-4 shadow-sm p-4">
                <h5 style="font-weight:800;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid #111;">
                    Datos de env&#237;o
                </h5>
                @using (Html.BeginForm("Checkout", "Carrito", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.NombreCliente, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.NombreCliente, new { @class = "form-control rounded-3", placeholder = "Tu nombre" })
                            @Html.ValidationMessageFor(m => m.NombreCliente, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.ApellidoCliente, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.ApellidoCliente, new { @class = "form-control rounded-3", placeholder = "Tu apellido" })
                            @Html.ValidationMessageFor(m => m.ApellidoCliente, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Identificacion, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Identificacion, new { @class = "form-control rounded-3", placeholder = "Cedula o pasaporte" })
                            @Html.ValidationMessageFor(m => m.Identificacion, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-md-6">
                            @Html.LabelFor(m => m.Telefono, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Telefono, new { @class = "form-control rounded-3", placeholder = "8888-8888" })
                            @Html.ValidationMessageFor(m => m.Telefono, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            @Html.LabelFor(m => m.Email, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.Email, new { @class = "form-control rounded-3", type = "email", placeholder = "correo@ejemplo.com" })
                            @Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            @Html.LabelFor(m => m.Direccion, new { @class = "form-label fw-bold" })
                            @Html.TextAreaFor(m => m.Direccion, new { @class = "form-control rounded-3", rows = 2, placeholder = "Direccion de entrega..." })
                            @Html.ValidationMessageFor(m => m.Direccion, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <h5 style="font-weight:800;margin:24px 0 16px;padding-top:16px;border-top:1px solid #eee;">
                        M&#233;todo de Pago
                    </h5>
                    <div class="row g-3">
                        <div class="col-12">
                            @Html.LabelFor(m => m.MetodoPagoId, new { @class = "form-label fw-bold" })
                            @{ var metodos = ViewBag.MetodosPago as IEnumerable<System.Web.Mvc.SelectListItem> ?? new List<System.Web.Mvc.SelectListItem>(); }
                            @Html.DropDownListFor(
                                               m => m.MetodoPagoId,
                                               metodos,
                                               "-- Seleccione metodo de pago --",
                                               new { @class = "form-select rounded-3" }
                                           )
                            @Html.ValidationMessageFor(m => m.MetodoPagoId, "", new { @class = "text-danger small" })
                        </div>
                        <div class="col-12">
                            @Html.LabelFor(m => m.ReferenciaPago, new { @class = "form-label fw-bold" })
                            @Html.TextBoxFor(m => m.ReferenciaPago, new { @class = "form-control rounded-3", placeholder = "Ej: SINPE12345 o ultimos 4 digitos de tarjeta" })
                            @Html.ValidationMessageFor(m => m.ReferenciaPago, "", new { @class = "text-danger small" })
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4">
                        <button type="submit" class="btn btn-dark rounded-3 fw-bold px-5 py-2 flex-grow-1"
                                style="font-size:16px;">
                            &#9989; Confirmar compra
                        </button>
                        <a href="@Url.Action("Index","Carrito")"
                           class="btn btn-outline-secondary rounded-3 fw-bold px-4 py-2">
                            &#8592; Volver
                        </a>
                    </div>
                }
            </div>
        </div>

        @*Resumen del pedido *@
       
        <div class="col-lg-5">
            <div class="bg-white rounded-4 shadow-sm p-4" style="position:sticky;top:100px;">
                <h5 style="font-weight:800;margin-bottom:20px;padding-bottom:12px;border-bottom:2px solid #111;">
                    Resumen del pedido
                </h5>
                @if (Model.ItemsCarrito != null && Model.ItemsCarrito.Any())
                {
                    <div style="max-height:300px;overflow-y:auto;margin-bottom:16px;">
                        @foreach (var item in Model.ItemsCarrito)
                        {
                            <div class="d-flex align-items-center gap-3 py-2 border-bottom">
                                <div style="width:48px;height:48px;flex-shrink:0;background:#f5f5f5;
                                                border-radius:8px;overflow:hidden;display:flex;
                                                align-items:center;justify-content:center;">
                                    @if (!string.IsNullOrEmpty(item.Imagen))
                                    {
                                        <img src="@Url.Content(item.Imagen)" alt="@item.Nombre"
                                             style="width:100%;height:100%;object-fit:contain;padding:4px;" />
                                    }
                                    else
                                    {
                                        <span style="font-size:20px;">&#128247;</span>
                                    }
                                </div>
                                <div style="flex:1;min-width:0;">
                                    <div style="font-size:13px;font-weight:600;white-space:nowrap;
                                                    overflow:hidden;text-overflow:ellipsis;">@item.Nombre</div>
                                                    <small class="text-muted">x@item.Cantidad</small>
                                                </div>
                                                <span style="font-weight:700;white-space:nowrap;font-size:14px;">
                                                    &#8353;@item.Subtotal.ToString("N0")
                                                </span>
                                            </div>
                                        }
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Subtotal</span>
                        <span>&#8353;@total.ToString("N0")</span>
                    </div>
                    <div class="d-flex justify-content-between py-2 border-bottom">
                        <span class="text-muted">Env&#237;o</span>
                        <span class="text-success fw-bold">Gratis</span>
                    </div>
                    <div class="d-flex justify-content-between pt-3">
                        <span style="font-weight:800;font-size:18px;">Total</span>
                        <span style="font-weight:800;font-size:18px;color:#e74c3c;">
                            &#8353;@total.ToString("N0")
                        </span>
                    </div>
                }
                <div class="mt-4 p-3 rounded-3" style="background:#f8f9fa;font-size:12px;color:#777;">
                    &#128274; Tus datos est&#225;n protegidos y seguros.<br />
                    &#128222; Si tienes dudas ll&#225;manos al +506 1234-5678.
                </div>
            </div>
        </div>

    </div>
    </div>
</section>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
