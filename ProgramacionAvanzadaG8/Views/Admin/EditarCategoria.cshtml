@* ============================================================ *@
@* ARCHIVO: EditarCategoria.cshtml                             *@
@* Ruta: Views/Admin/EditarCategoria.cshtml                    *@
@* ============================================================ *@
@model ProgramacionAvanzadaG8.Models.CategoriaModel
@{
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    ViewBag.Title = "Editar Categoría";
}

@using (Html.BeginForm("EditarCategoria", "Admin", FormMethod.Post,
    new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.CategoriaId)
    @Html.HiddenFor(m => m.Imagen)

    <div style="max-width:700px;">
        <div class="card">
            <div class="card-header">
                <span class="card-title">Editar: @Model.Nombre</span>
                <span class="badge badge-info" style="margin-left:8px;">ID #@Model.CategoriaId</span>
            </div>
            <div class="card-body">
                @Html.ValidationSummary(true, "", new { @class = "validation-summary-errors" })

                <div class="form-group">
                    @Html.LabelFor(m => m.Nombre,   new { @class = "form-label" })
                    @Html.TextBoxFor(m => m.Nombre, new { @class = "form-control" })
                    @Html.ValidationMessageFor(m => m.Nombre)
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Descripcion,    new { @class = "form-label" })
                    @Html.TextAreaFor(m => m.Descripcion, new { @class = "form-control", rows = 3 })
                    @Html.ValidationMessageFor(m => m.Descripcion)
                </div>

                <div class="form-group">
                    <label class="form-label">Imagen</label>

                    @if (!string.IsNullOrEmpty(Model.Imagen))
                    {
                        <div style="margin-bottom:12px;text-align:center;">
                            <p style="font-size:11px;color:var(--text-secondary);margin-bottom:8px;">Imagen actual</p>
                            <img src="@Url.Content(Model.Imagen)" style="max-height:120px;border-radius:8px;border:1px solid var(--border);" />
                        </div>
                    }

                    <div class="dropzone" id="dropzone" onclick="document.getElementById('imgInput').click()">
                        <div class="dropzone-icon">🔄</div>
                        <p><strong>Haz clic</strong> para reemplazar la imagen</p>
                        <p style="font-size:11px;margin-top:6px;">Opcional — si no subes nada, se conserva la actual</p>
                    </div>
                    <div id="previewContainer" style="display:none;text-align:center;margin-top:12px;">
                        <div class="dropzone-preview">
                            <img id="previewImg" src="" />
                            <button type="button" class="dropzone-remove" onclick="limpiarImg()">×</button>
                        </div>
                    </div>
                    @Html.TextBoxFor(m => m.ImagenFile,
                        new { type = "file", accept = "image/*", id = "imgInput", style = "display:none;" })
                    @Html.ValidationMessageFor(m => m.ImagenFile)
                </div>

                <div style="display:flex;gap:10px;margin-top:8px;">
                    <button type="submit" class="btn btn-primary">💾 Guardar Cambios</button>
                    <a href="@Url.Action("Categorias","Admin")" class="btn btn-ghost">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
<script>
    var input=document.getElementById('imgInput'), preview=document.getElementById('previewImg'), container=document.getElementById('previewContainer'), dropzone=document.getElementById('dropzone');
    input.addEventListener('change',function(){mostrarPreview(this.files[0]);});
    dropzone.addEventListener('dragover',function(e){e.preventDefault();dropzone.classList.add('dragover');});
    dropzone.addEventListener('dragleave',function(){dropzone.classList.remove('dragover');});
    dropzone.addEventListener('drop',function(e){e.preventDefault();dropzone.classList.remove('dragover');var f=e.dataTransfer.files[0];if(f){var dt=new DataTransfer();dt.items.add(f);input.files=dt.files;mostrarPreview(f);}});
    function mostrarPreview(file){var r=new FileReader();r.onload=function(e){preview.src=e.target.result;container.style.display='block';dropzone.style.display='none';};r.readAsDataURL(file);}
    function limpiarImg(){input.value='';preview.src='';container.style.display='none';dropzone.style.display='block';}
</script>
}
