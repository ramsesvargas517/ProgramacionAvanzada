@{
    ViewBag.Title = "Nueva Contrase&#241;a";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5" style="min-height:80vh;background:#f9f9f9;display:flex;align-items:center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">
                <div class="bg-white rounded-4 shadow-sm p-5">

                    <div class="text-center mb-4">
                        <div style="width:64px;height:64px;background:#d4edda;border-radius:50%;
                                    display:flex;align-items:center;justify-content:center;
                                    margin:0 auto 16px;font-size:28px;">&#128273;</div>
                        <h2 style="font-weight:800;font-size:1.6rem;margin:0 0 6px;">Nueva Contrase&#241;a</h2>
                        <p class="text-muted" style="font-size:14px;margin:0;">
                            Ingresa y confirma tu nueva contrase&#241;a.
                        </p>
                    </div>

                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger rounded-3">&#10060; @TempData["Error"]</div>
                    }

                    @using (Html.BeginForm("RestablecerContrasenna", "Account", FormMethod.Post,
                        new { id = "FormRestablecerContrasenna" }))
                    {
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="token" value="@ViewBag.Token" />

                        <div class="mb-3">
                            <label class="form-label fw-bold" style="font-size:14px;">
                                Nueva Contrase&#241;a
                            </label>
                            <input type="password" id="NuevaContrasenna" name="NuevaContrasenna"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="M&#237;nimo 6 caracteres" />
                            <span class="text-danger" id="err-nueva"></span>
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-bold" style="font-size:14px;">
                                Confirmar Contrase&#241;a
                            </label>
                            <input type="password" id="ConfirmarContrasenna" name="ConfirmarContrasenna"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="Repite la contrase&#241;a" />
                            <span class="text-danger" id="err-confirmar"></span>
                        </div>

                        <div class="d-grid">
                            <button type="submit" class="btn btn-dark btn-lg rounded-3 fw-bold">
                                Guardar contrase&#241;a
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>$(function () {
    $("#FormRestablecerContrasenna").validate({
        rules: {
            NuevaContrasenna: {
                required: true,
                minlength: 6
            },
            ConfirmarContrasenna: {
                required: true,
                equalTo: "#NuevaContrasenna"
            }
        },
        messages: {
            NuevaContrasenna: {
                required: "Campo requerido",
                minlength: "M\u00ednimo 6 caracteres"
            },
            ConfirmarContrasenna: {
                required: "Campo requerido",
                equalTo: "Las contrase\u00f1as no coinciden"
            }
        },
        errorElement: "span",
        errorClass: "text-danger",
        highlight: function (element) { $(element).addClass("is-invalid"); },
        unhighlight: function (element) { $(element).removeClass("is-invalid"); }
    });
});</script>
}
