@{
    ViewBag.Title = "Recuperar Contrase&#241;a";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="py-5" style="min-height:80vh;background:#f9f9f9;display:flex;align-items:center;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5">

                <div class="bg-white rounded-4 shadow-sm p-5">

                    <div class="text-center mb-4">
                        <div style="width:64px;height:64px;background:#fff3cd;border-radius:50%;
                                    display:flex;align-items:center;justify-content:center;
                                    margin:0 auto 16px;font-size:28px;">&#128274;</div>
                        <h2 style="font-weight:800;font-size:1.6rem;margin:0 0 6px;">
                            Recuperar Contrase&#241;a
                        </h2>
                        <p class="text-muted" style="font-size:14px;margin:0;">
                            Ingresa tu correo y te enviaremos un enlace para restablecer tu contrase&#241;a.
                        </p>
                    </div>

                    @if (TempData["Success"] != null)
                    {
                        <div class="alert alert-success d-flex align-items-center gap-2 rounded-3" role="alert">
                            <span>&#9989;</span> <span>@TempData["Success"]</span>
                        </div>
                    }
                    @if (TempData["Error"] != null)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-3" role="alert">
                            <span>&#10060;</span> <span>@TempData["Error"]</span>
                        </div>
                    }
                    @* Mostrar detalle de error SMTP en desarrollo si existe *@
                    @if (TempData["ErrorDetalleCorreo"] != null)
                    {
                        <div class="alert alert-warning d-flex align-items-center gap-2 rounded-3" role="alert">
                            <strong>Detalle:</strong> @TempData["ErrorDetalleCorreo"]
                        </div>
                    }

                    @using (Html.BeginForm("RecuperarContrasenna", "Account", FormMethod.Post,
                        new { id = "FormRecuperarContrasenna" }))
                    {
                        @Html.AntiForgeryToken()

                        <div class="mb-4">
                            <label for="CorreoElectronico" class="form-label fw-bold" style="font-size:14px;">
                                Correo Electr&#243;nico
                            </label>
                            <input type="email" id="CorreoElectronico" name="CorreoElectronico"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="correo@ejemplo.com"
                                   value="@(TempData["CorreoIngresado"] ?? "")" />
                        </div>

                        <div class="d-grid mb-3">
                            <button type="submit" class="btn btn-dark btn-lg rounded-3 fw-bold"
                                    style="font-size:16px;">
                                Enviar enlace &#128231;
                            </button>
                        </div>

                        <div class="text-center">
                            <a href="@Url.Action("Login","Account")"
                               style="color:#555;font-size:14px;text-decoration:none;">
                                &#8592; Volver al inicio de sesi&#243;n
                            </a>
                        </div>
                    }
                </div>

            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>$(function () {
    $("#FormRecuperarContrasenna").validate({
        rules: {
            CorreoElectronico: {
                required: true,
                email: true
            }
        },
        messages: {
            CorreoElectronico: {
                required: "Campo requerido",
                email: "Formato incorrecto"
            }
        },
        errorElement: "span",
        errorClass: "text-danger",
        highlight: function (element) {
            $(element).addClass("is-invalid");
        },
        unhighlight: function (element) {
            $(element).removeClass("is-invalid");
        }
    });
});</script>
}
